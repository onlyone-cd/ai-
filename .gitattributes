# Keep source, configuration, and documentation text stable across platforms.
* text=auto
.gitattributes text eol=lf
.env* text eol=lf

*.py   text eol=lf
*.pyi  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini  text eol=lf
*.conf text eol=lf
*.sh   text eol=lf

# PowerShell and Windows command files are kept as CRLF for native tooling.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary project assets must never be line-ending normalized.
*.docx binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.tar  binary
